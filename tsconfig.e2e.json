/*
 * Standalone TypeScript configuration for the Playwright end to end tests.
 *
 * The Playwright runner resolves `extends` on its own and cannot follow the
 * bare `@grafana/tsconfig` specifier used by ./.config/tsconfig.json, so the
 * e2e side gets a self contained config instead. It is passed to Playwright
 * through `playwright test --tsconfig`, and used by `npm run typecheck`.
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./playwright.config.ts", "./tests/**/*.ts", "./src/testIds.ts"]
}
