{
  "name": "@ludovicm67/mongodb-datasource",
  "version": "1.2.1",
  "private": true,
  "description": "Add support for MongoDB",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ./tsconfig.e2e.json",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test --tsconfig ./tsconfig.e2e.json",
    "e2e:ui": "npm run e2e -- --ui",
    "server": "docker compose up --build -d",
    "server:logs": "docker compose logs -f",
    "server:down": "docker compose down -v",
    "sign": "sign-plugin",
    "update": "npx --yes @grafana/create-plugin@latest update",
    "release": "changeset git-tag"
  },
  "author": {
    "name": "Ludovic Muller",
    "url": "https://ludovic-muller.fr/"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.1",
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.11.0",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.67.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.9.6",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "webpack": "^5.110.2",
    "webpack-cli": "^7.2.3",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.6"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@grafana/data": "^13.2.0",
    "@grafana/i18n": "^13.2.0",
    "@grafana/runtime": "^13.2.0",
    "@grafana/schema": "^13.2.0",
    "@grafana/ui": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tslib": "^2.6.2"
  },
  "packageManager": "npm@11.17.0"
}
