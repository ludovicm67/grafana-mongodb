{
  "name": "@ludovicm67/mongodb-datasource",
  "version": "1.1.0",
  "private": true,
  "description": "Add support for MongoDB",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ./tsconfig.e2e.json",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test --tsconfig ./tsconfig.e2e.json",
    "e2e:ui": "npm run e2e -- --ui",
    "server": "docker compose up --build -d",
    "server:logs": "docker compose logs -f",
    "server:down": "docker compose down -v",
    "sign": "sign-plugin",
    "update": "npx --yes @grafana/create-plugin@latest update",
    "release": "changeset tag"
  },
  "author": {
    "name": "Ludovic Muller",
    "url": "https://ludovic-muller.fr/"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.29.7",
    "@changesets/cli": "^2.31.1",
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.10.0",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.62.0",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/core": "^1.15.46",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@grafana/data": "^13.1.1",
    "@grafana/i18n": "^13.1.1",
    "@grafana/runtime": "^13.1.1",
    "@grafana/schema": "^13.1.1",
    "@grafana/ui": "^13.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tslib": "^2.6.2"
  },
  "packageManager": "npm@11.16.0"
}
